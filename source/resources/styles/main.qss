/* ═══════════════════════════════════════════
   scFlow Studio — Light theme (polished edition)
   ═══════════════════════════════════════════ */

* {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget {
    background-color: #f8f9fa;
    color: #2d3436;
}

QLabel#page_title {
    font-size: 20px;
    font-weight: 700;
    color: #1f4e79;
    padding: 4px 2px 0 2px;
}

QLabel#workflow_tip {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #eef6ff, stop:1 #f8fbff);
    color: #4c6272;
    border: 1px solid #d7e7f6;
    border-radius: 8px;
    padding: 8px 12px;
}

/* ── Group boxes ── */
QGroupBox {
    font-weight: bold;
    font-size: 13px;
    color: #2980b9;
    border: 1px solid #dfe6e9;
    border-radius: 6px;
    margin-top: 12px;
    padding: 14px 10px 10px 10px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #2980b9;
}

/* ── Input widgets ── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #dfe6e9;
    border-radius: 4px;
    padding: 4px 8px;
    color: #2d3436;
    min-height: 24px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #3498db;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border: none;
    border-left: 1px solid #d0d7de;
    width: 28px;
    background-color: #eef4fb;
}
QComboBox:editable {
    padding-right: 28px;
}
QComboBox QLineEdit {
    background: transparent;
    color: #2d3436;
    selection-background-color: #d6eaf8;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2d3436;
    selection-background-color: #dfe6e9;
    border: 1px solid #b2bec3;
}

/* ── Buttons ── */
QPushButton {
    background-color: #ffffff;
    color: #2d3436;
    border: 1px solid #dfe6e9;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 26px;
}
QPushButton:hover {
    background-color: #ebf5fb;
    border-color: #3498db;
}
QPushButton:pressed {
    background-color: #d4efdf;
}
QPushButton:disabled {
    background-color: #f0f0f0;
    color: #b2bec3;
}

/* ── Tables ── */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8f9fa;
    color: #2d3436;
    gridline-color: #ecf0f1;
    border: 1px solid #dfe6e9;
    border-radius: 4px;
}
QHeaderView::section {
    background-color: #f8f9fa;
    color: #2980b9;
    font-weight: bold;
    padding: 5px 8px;
    border: none;
    border-bottom: 2px solid #3498db;
}

/* ── Lists ── */
QListWidget {
    background-color: #ffffff;
    color: #2d3436;
    border: 1px solid #dfe6e9;
    border-radius: 4px;
}
QListWidget::item:selected {
    background-color: #d6eaf8;
    color: #2980b9;
}
QListWidget::item:hover {
    background-color: #ebf5fb;
}

/* ── Tabs ── */
QTabBar::tab {
    background-color: #f0f0f0;
    color: #636e72;
    padding: 6px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2980b9;
    border-bottom: 2px solid #3498db;
}
QTabBar::tab:hover {
    background-color: #ebf5fb;
}

QTabWidget#page_tabs::pane {
    border: 1px solid #dfe6e9;
    border-radius: 10px;
    background-color: #ffffff;
    top: -1px;
}

/* ── Checkboxes and radio buttons ── */
QCheckBox, QRadioButton {
    color: #2d3436;
    spacing: 6px;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: #f8f9fa;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #b2bec3;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #636e72;
}

/* ── Toolbar ── */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #dfe6e9;
    spacing: 4px;
    padding: 2px;
}
QToolBar QToolButton {
    color: #2d3436;
    padding: 4px 8px;
    border-radius: 4px;
}
QToolBar QToolButton:hover {
    background-color: #ebf5fb;
}
QToolBar QComboBox {
    min-width: 120px;
    background-color: #ffffff;
    color: #2d3436;
    border: 1px solid #c9d6e2;
}

/* ── Status bar ── */
QStatusBar {
    background-color: #ffffff;
    color: #636e72;
    border-top: 1px solid #dfe6e9;
}

/* ── Progress bar ── */
QProgressBar {
    border: 1px solid #dfe6e9;
    border-radius: 4px;
    text-align: center;
    color: #2d3436;
    background-color: #ecf0f1;
    height: 16px;
}
QProgressBar::chunk {
    background-color: #3498db;
    border-radius: 3px;
}

/* ── Notice boxes ── */
QToolTip {
    background-color: #2d3436;
    color: #ffffff;
    border: none;
    padding: 4px;
    border-radius: 4px;
}

/* ── Sidebar ── */
QListWidget#sidebar {
    background-color: #2c3e50;
    color: #ecf0f1;
    border: none;
    font-size: 13px;
}
QListWidget#sidebar::item {
    padding: 10px 14px;
    border-left: 3px solid transparent;
}
QListWidget#sidebar::item:selected {
    background-color: #34495e;
    border-left: 3px solid #3498db;
    color: #ffffff;
}
QListWidget#sidebar::item:hover {
    background-color: #34495e;
}


QPushButton[role="primary"] {
    font-weight: bold;
}
QPushButton[role="success"] {
    font-weight: bold;
}
QPushButton[role="accent"] {
    font-weight: bold;
}
QPushButton[role="primary"]:disabled,
QPushButton[role="success"]:disabled,
QPushButton[role="accent"]:disabled {
    opacity: 0.75;
}
#preview_title, #sidebar_title {
    font-weight: bold;
}
QToolBar QLabel, QToolBar QComboBox, QToolBar QToolButton {
    min-height: 28px;
}

QFrame#page_action_bar {
    background: #ffffff;
    border: 1px solid #dfe6e9;
    border-radius: 10px;
}

QLabel#action_hint {
    color: #6b7b88;
    padding-right: 8px;
}

QPushButton[role="primary"] { background-color: #1f6feb; color: #ffffff; border: 1px solid #1857b7; }
QPushButton[role="primary"]:hover { background-color: #2a78f6; }
QPushButton[role="success"] { background-color: #2e8b57; color: #ffffff; border: 1px solid #236b43; }
QPushButton[role="success"]:hover { background-color: #3a9b66; }
QPushButton[role="accent"] { background-color: #8e44ad; color: #ffffff; border: 1px solid #6c3483; }
QPushButton[role="accent"]:hover { background-color: #9b59b6; }
QPushButton[role="ghost"] { background-color: #f7fafc; color: #3d5568; border: 1px solid #d2dce6; }
QPushButton[role="ghost"]:hover { background-color: #edf4fb; border: 1px solid #b9cce0; }
QToolBar QComboBox { background-color: #ffffff; color: #2d3436; }
QLabel#sidebar_title { background-color: #2c3e50; color: #ecf0f1; padding-left: 12px; }
